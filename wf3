const form = document.getElementById('itemForm');
const itemList = document.getElementById('itemList');
const message = document.getElementById('message');
const itemId = document.getElementById('itemId');
const submitBtn = document.getElementById('submitBtn');
const cancelBtn = document.getElementById('cancelBtn');

function showMessage(text, error = false) {
    message.textContent = text;
    message.className = error ? 'error' : '';
}

// Fetch and display all items
async function loadItems() {
    try {
        const response = await fetch('/api/items');
        if (!response.ok) throw new Error('Failed to load items');

        const items = await response.json();
        itemList.replaceChildren();

        if (items.length === 0) {
            itemList.textContent = 'No items available.';
            return;
        }

        items.forEach(item => {
            const card = document.createElement('div');
            card.className = 'item';

            const title = document.createElement('h3');
            title.textContent = item.name;

            const description = document.createElement('p');
            description.textContent =
                'Description: ' + (item.description || 'None');

            const price = document.createElement('p');
            price.textContent = 'Price: $' +
                Number(item.price).toFixed(2);

            const stock = document.createElement('p');
            stock.textContent = item.inStock
                ? 'In Stock' : 'Out of Stock';

            const editBtn = document.createElement('button');
            editBtn.textContent = 'Edit';
            editBtn.addEventListener('click', () => editItem(item));

            const deleteBtn = document.createElement('button');
            deleteBtn.textContent = 'Delete';
            deleteBtn.addEventListener('click', () => deleteItem(item._id));

            card.append(title, description, price, stock, editBtn, deleteBtn);
            itemList.appendChild(card);
        });
    } catch (err) {
        showMessage(err.message, true);
    }
}

// Add or update an item
form.addEventListener('submit', async event => {
    event.preventDefault();

    const data = {
        name: document.getElementById('name').value.trim(),
        description: document.getElementById('description').value.trim(),
        price: Number(document.getElementById('price').value),
        inStock: document.getElementById('inStock').checked
    };

    if (!data.name || document.getElementById('price').value === '' ||
        !Number.isFinite(data.price) || data.price < 0) {
        showMessage('Enter a valid name and price.', true);
        return;
    }

    const id = itemId.value;
    const url = id ? `/api/items/${id}` : '/api/items';
    const method = id ? 'PUT' : 'POST';

    try {
        const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Operation failed');

        form.reset();
        itemId.value = '';
        submitBtn.textContent = 'Add Item';
        cancelBtn.hidden = true;

        showMessage(id ? 'Item updated successfully!' :
            'Item added successfully!');

        await loadItems();
    } catch (err) {
        showMessage(err.message, true);
    }
});

// Load item details into the form for editing
function editItem(item) {
    itemId.value = item._id;
    document.getElementById('name').value = item.name;
    document.getElementById('description').value = item.description || '';
    document.getElementById('price').value = item.price;
    document.getElementById('inStock').checked = item.inStock;

    submitBtn.textContent = 'Update Item';
    cancelBtn.hidden = false;
    document.getElementById('formTitle').textContent = 'Edit Item';
    document.getElementById('name').focus();
}

// Delete an item
async function deleteItem(id) {
    if (!confirm('Are you sure you want to delete this item?')) return;

    try {
        const response = await fetch(`/api/items/${id}`, {
            method: 'DELETE'
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Delete failed');

        showMessage('Item deleted successfully!');
        await loadItems();
    } catch (err) {
        showMessage(err.message, true);
    }
}

// Cancel editing
cancelBtn.addEventListener('click', () => {
    form.reset();
    itemId.value = '';
    submitBtn.textContent = 'Add Item';
    cancelBtn.hidden = true;
    document.getElementById('formTitle').textContent = 'Add New Item';
    showMessage('');
});

// Initial display
loadItems();
